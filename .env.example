# ZRMA Anonymous Board - Environment Configuration (Next.js + Prisma + PostgreSQL)
#
# Connection URL format:
# postgresql://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
#
# Local Docker Compose PostgreSQL 16 (docker compose up -d):
DATABASE_URL="postgresql://postgres:zrma_postgres_password@localhost:5433/zrma?schema=public"

# Cloud Hosted PostgreSQL examples (Neon / Supabase / Railway / RDS):
# DATABASE_URL="postgresql://user:pass@ep-shiny-pond.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

PORT=3000
