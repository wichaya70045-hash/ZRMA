# ZRMA Anonymous Board - Environment Configuration

# Database Configuration (PostgreSQL with Prisma)
# Example PostgreSQL Connection URL:
# postgresql://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
#
# Examples:
# Local PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zrma_db?schema=public"
#
# Cloud Hosted PostgreSQL (Neon / Supabase / Railway / Aiven):
# DATABASE_URL="postgresql://user:pass@ep-shiny-pond.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zrma?schema=public"

# Database Mode:
# 'sqlite' (default, uses local zero-config SQLite Database in data/privacy_board.sqlite)
# 'prisma' (uses Prisma Client connected to PostgreSQL via DATABASE_URL)
DB_MODE="sqlite"

# Next.js Server Port
PORT=3000
