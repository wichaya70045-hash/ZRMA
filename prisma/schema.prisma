// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Community {
  name        String   @id
  title       String
  description String?
  icon        String?  @default("terminal")
  postCount   Int      @default(0) @map("post_count")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("communities")
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  displayName  String    @map("display_name")
  passwordHash String    @map("password_hash")
  bio          String?   @default("")
  avatarIcon   String?   @default("shield") @map("avatar_icon")
  avatarUrl    String?   @map("avatar_url")
  avatarFrame  String?   @default("none") @map("avatar_frame")
  bannerTheme  String?   @default("obsidian") @map("banner_theme")
  nameColor    String?   @default("default") @map("name_color")
  customBadge  String?   @map("custom_badge")
  createdAt    DateTime  @default(now()) @map("created_at")

  threads      Thread[]
  comments     Comment[]

  @@map("users")
}

model Thread {
  id            String    @id @default(uuid())
  title         String
  content       String
  category      String
  flair         String?
  sourceUrl     String?   @map("source_url")
  mediaUrl      String?   @map("media_url")
  mediaType     String?   @map("media_type")
  requiresLogin Boolean   @default(false) @map("requires_login")
  authorAlias   String    @map("author_alias")
  authorAvatar  String    @map("author_avatar")
  authorUserId  String?   @map("author_user_id")
  upvotes       Int       @default(0)
  downvotes     Int       @default(0)
  reportCount   Int       @default(0) @map("report_count")
  isHidden      Boolean   @default(false) @map("is_hidden")
  isPinned      Boolean   @default(false) @map("is_pinned")
  isEdited      Boolean   @default(false) @map("is_edited")
  editedAt      DateTime? @map("edited_at")
  editToken     String?   @map("edit_token")
  pollData      String?   @map("poll_data")
  jobData       String?   @map("job_data")
  marketData    String?   @map("market_data")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  author        User?     @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  comments      Comment[]

  @@index([expiresAt], map: "idx_threads_expires")
  @@index([category], map: "idx_threads_category")
  @@index([createdAt(sort: Desc)], map: "idx_threads_created")
  @@map("threads")
}

model Comment {
  id           String    @id @default(uuid())
  threadId     String    @map("thread_id")
  parentId     String?   @map("parent_id")
  quoteText    String?   @map("quote_text")
  quoteAuthor  String?   @map("quote_author")
  content      String
  mediaUrl     String?   @map("media_url")
  authorAlias  String    @map("author_alias")
  authorAvatar String    @map("author_avatar")
  authorUserId String?   @map("author_user_id")
  upvotes      Int       @default(0)
  downvotes    Int       @default(0)
  reportCount  Int       @default(0) @map("report_count")
  isHidden     Boolean   @default(false) @map("is_hidden")
  isEdited     Boolean   @default(false) @map("is_edited")
  editedAt     DateTime? @map("edited_at")
  editToken    String?   @map("edit_token")
  createdAt    DateTime  @default(now()) @map("created_at")

  thread       Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  parent       Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[] @relation("CommentReplies")
  author       User?     @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([threadId], map: "idx_comments_thread")
  @@index([parentId], map: "idx_comments_parent")
  @@index([createdAt(sort: Asc)], map: "idx_comments_created")
  @@map("comments")
}

model ChatMessage {
  id           String    @id @default(uuid())
  roomId       String    @default("global") @map("room_id")
  content      String
  authorAlias  String    @map("author_alias")
  authorAvatar String    @map("author_avatar")
  authorUserId String?   @map("author_user_id")
  reportCount  Int       @default(0) @map("report_count")
  isHidden     Boolean   @default(false) @map("is_hidden")
  isEdited     Boolean   @default(false) @map("is_edited")
  editedAt     DateTime? @map("edited_at")
  editToken    String?   @map("edit_token")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([roomId, createdAt(sort: Desc)], map: "idx_chat_room")
  @@map("chat_messages")
}

model Report {
  id         String   @id @default(uuid())
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  reason     String
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("reports")
}

model GhostRoom {
  id           String   @id @default(uuid())
  name         String   @unique
  title        String
  topic        String?
  creatorAlias String   @map("creator_alias")
  activeUsers  Int      @default(1) @map("active_users")
  lastActiveAt DateTime @map("last_active_at")
  isDestroyed  Boolean  @default(false) @map("is_destroyed")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([isDestroyed, lastActiveAt(sort: Desc)], map: "idx_ghost_rooms")
  @@map("ghost_rooms")
}

model UsedCaptcha {
  tokenHash String   @id @map("token_hash")
  expiresAt BigInt   @map("expires_at")

  @@index([expiresAt], map: "idx_used_captchas_exp")
  @@map("used_captchas")
}
